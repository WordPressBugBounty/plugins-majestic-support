msgid "Eliminate manual triage by automatically routing new tickets to available agents."
msgstr "با هدایت خودکار تیکت‌های جدید به کارشناسان در دسترس، بررسی و ارجاع دستی را حذف کنید."

msgid "Add Rule"
msgstr "افزودن قانون"

msgid "Set up a new automated rule for distributing incoming tickets."
msgstr "یک قانون خودکار جدید برای توزیع تیکت‌های ورودی تنظیم کنید."

msgid "Manage granular access levels and security privileges for your support staff."
msgstr "سطوح دسترسی دقیق و مجوزهای امنیتی کارکنان پشتیبانی را مدیریت کنید."

msgid "Add Permissions"
msgstr "افزودن مجوزها"

msgid "Select the modules and features this new permission set can access."
msgstr "ماژول‌ها و قابلیت‌هایی را که این مجموعه مجوز جدید می‌تواند به آن‌ها دسترسی داشته باشد انتخاب کنید."

msgid "The control center for your support desk. Manage all your core configurations here."
msgstr "مرکز کنترل میز پشتیبانی شما. همه پیکربندی‌های اصلی را اینجا مدیریت کنید."

msgid "The exact trigger links required to keep your email fetching, notifications, and cleanups running on time."
msgstr "لینک‌های اجرای دقیق موردنیاز برای اینکه دریافت ایمیل، اعلان‌ها و پاک‌سازی‌ها به‌موقع اجرا شوند."

msgid "How to add Shortcode"
msgstr "نحوه افزودن کد کوتاه"

msgid "A complete list of codes to integrate Majestic Support features directly into your site's pages."
msgstr "فهرست کامل کدها برای افزودن مستقیم قابلیت‌های Majestic Support به صفحات سایت شما."

msgid "How to set colors"
msgstr "نحوه تنظیم رنگ‌ها"

msgid "Customize the look and feel of your support portal to match your brand."
msgstr "ظاهر و حس پرتال پشتیبانی را مطابق برند خود سفارشی کنید."

msgid "Deep dive into your support metrics, ticket volume, and team performance"
msgstr "بررسی عمیق معیارهای پشتیبانی، حجم تیکت‌ها و عملکرد تیم"

msgid "Export Data"
msgstr "خروجی گرفتن از داده‌ها"

msgid "Get a complete, bird's-eye view of your entire support operation."
msgstr "نمایی کامل و کلی از کل عملیات پشتیبانی خود دریافت کنید."

msgid "Track individual agent performance, resolution times, and daily productivity."
msgstr "عملکرد هر کارشناس، زمان حل و بهره‌وری روزانه را پیگیری کنید."

msgid "Agent Detail Report"
msgstr "گزارش کارشناس پشتیبانی جزئیات"

msgid "View a complete timeline of an agent's workload, resolutions, and active tickets."
msgstr "خط زمانی کامل حجم کار، موارد حل‌شده و تیکت‌های فعال یک کارشناس را مشاهده کنید."

msgid "Identify which departments are experiencing high traffic and where more resources are needed."
msgstr "تشخیص دهید کدام دپارتمان‌ها بار کاری بیشتری دارند و کجا به منابع بیشتری نیاز است."

msgid "Department Detail Report"
msgstr "گزارش دپارتمان جزئیات"

msgid "Analyze the full lifecycle of tickets and agent efficiency within this chosen department."
msgstr "چرخه کامل عمر تیکت‌ها و کارایی کارشناسان را در این دپارتمان انتخاب‌شده تحلیل کنید."

msgid "Analyze ticket volume and support engagement across your entire user base."
msgstr "حجم تیکت‌ها و تعامل پشتیبانی را در کل کاربران خود تحلیل کنید."

msgid "User Detail Report"
msgstr "گزارش جزئیات کاربر"

msgid "View the complete support history, ticket timeline, and interaction data for a specific user."
msgstr "تاریخچه کامل پشتیبانی، خط زمانی تیکت‌ها و داده‌های تعامل یک کاربر خاص را مشاهده کنید."

msgid "Satisfaction Reports"
msgstr "گزارش‌های رضایت"

msgid "Monitor customer happiness and review the ratings left for your support team."
msgstr "رضایت مشتریان را پایش کرده و امتیازهای ثبت‌شده برای تیم پشتیبانی را بررسی کنید."

msgid "Add Email Piping"
msgstr "افزودن پایپینگ ایمیل"

msgid "Set up an email gateway to sync your support inbox directly with the dashboard."
msgstr "یک درگاه ایمیل تنظیم کنید تا صندوق پشتیبانی مستقیماً با داشبورد همگام شود."

msgid "View and monitor all active email connections and their synchronization status."
msgstr "همه اتصال‌های فعال ایمیل و وضعیت همگام‌سازی آن‌ها را مشاهده و پایش کنید."

msgid "Add GDPR Field"
msgstr "افزودن GDPR فیلد"

msgid "Create a new compliance field for your forms to ensure data protection standards."
msgstr "برای رعایت استانداردهای حفاظت از داده، یک فیلد انطباق جدید برای فرم‌های خود ایجاد کنید."

msgid "Manage the data protection and privacy consent fields used throughout your support system."
msgstr "فیلدهای رضایت حریم خصوصی و حفاظت از داده را که در سراسر سیستم پشتیبانی استفاده می‌شوند مدیریت کنید."

msgid "Review and process user requests to have their personal data permanently removed."
msgstr "درخواست‌های کاربران برای حذف دائمی داده‌های شخصی را بررسی و پردازش کنید."

msgid "Explore and manage available extensions to power up your support dashboard."
msgstr "افزونه‌های موجود را برای تقویت داشبورد پشتیبانی بررسی و مدیریت کنید."

msgid "Unlock advanced features and professional tools with our premium support extensions."
msgstr "با افزودنی‌های حرفه‌ای پشتیبانی، قابلیت‌های پیشرفته و ابزارهای حرفه‌ای را فعال کنید."

msgid "Follow the steps below to successfully install and activate your new features."
msgstr "برای نصب و فعال‌سازی موفق قابلیت‌های جدید، مراحل زیر را دنبال کنید."

msgid "View the ratings and comments left by users to monitor your service quality."
msgstr "برای پایش کیفیت خدمات، امتیازها و دیدگاه‌های ثبت‌شده توسط کاربران را مشاهده کنید."

msgid "Create a new team or category to help organize and route incoming tickets."
msgstr "برای سازمان‌دهی و مسیریابی تیکت‌های ورودی، یک تیم یا دسته‌بندی جدید ایجاد کنید."

msgid "Manage your support divisions and assign agents to specific team queues."
msgstr "بخش‌های پشتیبانی خود را مدیریت کرده و کارشناسان را به صف‌های تیمی مشخص اختصاص دهید."

msgid "Define a new urgency level to help your team prioritize critical issues."
msgstr "برای کمک به اولویت‌بندی مشکلات حیاتی، یک سطح فوریت جدید تعریف کنید."

msgid "Customize ticket urgency levels and visual indicators for your support queue."
msgstr "سطوح فوریت تیکت و نشانگرهای بصری صف پشتیبانی را سفارشی کنید."

msgid "Add Status"
msgstr "افزودن وضعیت"

msgid "Create a new custom status to better track the lifecycle of your tickets."
msgstr "برای رهگیری بهتر چرخه عمر تیکت‌ها، یک وضعیت سفارشی جدید ایجاد کنید."

msgid "Manage the different stages a ticket moves through from open to resolved."
msgstr "مراحل مختلفی را که تیکت از حالت باز تا حل‌شده طی می‌کند مدیریت کنید."

msgid "View and manage the products or services your team provides support for."
msgstr "محصولات یا خدماتی را که تیم شما برای آن‌ها پشتیبانی ارائه می‌دهد مشاهده و مدیریت کنید."

msgid "Register a new product to allow customers to select it when opening tickets."
msgstr "یک محصول جدید ثبت کنید تا مشتریان هنگام ایجاد تیکت بتوانند آن را انتخاب کنند."

msgid "Upload and migrate your existing ticket or user data into the system."
msgstr "داده‌های موجود تیکت یا کاربر را در سیستم بارگذاری و مهاجرت دهید."

msgid "Import Data Report"
msgstr "درون‌ریزی داده‌ها گزارش"

msgid "Review the success rate and details of your most recent data migration."
msgstr "نرخ موفقیت و جزئیات جدیدترین مهاجرت داده را بررسی کنید."

msgid "Create a new grouping for your Knowledge Base articles or FAQs."
msgstr "برای مقالات پایگاه دانش یا پرسش‌های متداول، یک گروه‌بندی جدید ایجاد کنید."

msgid "Organize your support content into logical groups for easier browsing."
msgstr "محتوای پشتیبانی را برای مرور آسان‌تر در گروه‌های منطقی سازمان‌دهی کنید."

msgid "Write and publish a new article to help users find answers themselves."
msgstr "یک مقاله جدید بنویسید و منتشر کنید تا کاربران خودشان پاسخ را پیدا کنند."

msgid "How to use Knowledge Base"
msgstr "نحوه استفاده از پایگاه دانش"

msgid "Manage your self-service articles and help guides in one central location."
msgstr "مقالات خودیاری و راهنماهای کمک را در یک محل مرکزی مدیریت کنید."

msgid "Upload a new file, driver, or document for your customers to download."
msgstr "یک فایل، درایور یا سند جدید برای دانلود مشتریان بارگذاری کنید."

msgid "How to use downloads"
msgstr "نحوه استفاده از دانلودها"

msgid "Manage the files and resources available for your users to access and download."
msgstr "فایل‌ها و منابع قابل دسترسی و دانلود برای کاربران را مدیریت کنید."

msgid "Create a new frequently asked question and answer pair for your site."
msgstr "یک پرسش و پاسخ متداول جدید برای سایت خود ایجاد کنید."

msgid "How to create FAQ"
msgstr "نحوه ایجاد پرسش متداول"

msgid "Organize and manage quick answers to the most common customer questions."
msgstr "پاسخ‌های سریع به رایج‌ترین پرسش‌های مشتریان را سازمان‌دهی و مدیریت کنید."

msgid "Post a new news update or system alert for your users to see."
msgstr "یک خبر جدید یا هشدار سیستمی منتشر کنید تا کاربران ببینند."

msgid "How to add announcement"
msgstr "نحوه افزودن اطلاعیه"

msgid "Manage the global notifications and news updates shown to your customers."
msgstr "اعلان‌های عمومی و به‌روزرسانی‌های خبری نمایش‌داده‌شده به مشتریان را مدیریت کنید."

msgid "Add Help Topics"
msgstr "افزودن موضوعات راهنما"

msgid "How to use help topic"
msgstr "نحوه استفاده از موضوع راهنما"

msgid "Manage the subject lines users can select when opening a new ticket."
msgstr "موضوعاتی را که کاربران هنگام ایجاد تیکت جدید می‌توانند انتخاب کنند مدیریت کنید."

msgid "Create a new predefined topic to help categorize incoming user requests."
msgstr "برای دسته‌بندی درخواست‌های ورودی کاربران، یک موضوع از پیش تعریف‌شده جدید ایجاد کنید."

msgid "How to set SMTP"
msgstr "نحوه تنظیم SMTP"

msgid "Configure the mail accounts used by the system to send notifications and replies."
msgstr "حساب‌های ایمیلی را که سیستم برای ارسال اعلان‌ها و پاسخ‌ها استفاده می‌کند پیکربندی کنید."

msgid "Connect a new email account to the system for outgoing or incoming mail."
msgstr "یک حساب ایمیل جدید برای ایمیل‌های ورودی یا خروجی به سیستم متصل کنید."

msgid "Manage your library of 'canned responses' to answer common questions instantly."
msgstr "کتابخانه پاسخ‌های آماده خود را برای پاسخ سریع به پرسش‌های رایج مدیریت کنید."

msgid "Draft a new reusable message template to speed up agent reply times."
msgstr "یک قالب پیام قابل استفاده مجدد ایجاد کنید تا زمان پاسخ کارشناسان کوتاه‌تر شود."

msgid "Define agent roles and manage their access levels within the dashboard."
msgstr "نقش‌های کارشناسان و سطوح دسترسی آن‌ها را در داشبورد مدیریت کنید."

msgid "Create a new staff role with specific permissions and system access."
msgstr "یک نقش کارمند جدید با مجوزها و دسترسی سیستم مشخص ایجاد کنید."

msgid "View your incoming mail queue and manage communication from your customers."
msgstr "صف ایمیل‌های ورودی را مشاهده کرده و ارتباط با مشتریان را مدیریت کنید."

msgid "Review sent messages and pending outgoing communication from your system."
msgstr "پیام‌های ارسال‌شده و ارتباطات خروجی در انتظار را در سیستم بررسی کنید."

msgid "Draft and send a new direct message or announcement to your users."
msgstr "یک پیام مستقیم یا اعلان جدید برای کاربران خود ایجاد و ارسال کنید."

msgid "Review the details of this specific communication and its thread history."
msgstr "جزئیات این ارتباط خاص و تاریخچه رشته گفتگوی آن را بررسی کنید."

msgid "View a history of blocked attempts from blacklisted email addresses."
msgstr "تاریخچه تلاش‌های مسدودشده از آدرس‌های ایمیل لیست سیاه را مشاهده کنید."

msgid "Add Banned Email"
msgstr "افزودن ایمیل مسدود"

msgid "Block specific email addresses or domains from creating tickets in your system."
msgstr "آدرس‌های ایمیل یا دامنه‌های مشخص را از ایجاد تیکت در سیستم خود مسدود کنید."

msgid "Blacklist a specific address to prevent spam or unwanted ticket submissions."
msgstr "برای جلوگیری از هرزنامه یا ارسال تیکت ناخواسته، یک آدرس مشخص را به لیست سیاه اضافه کنید."

msgid "How to use email cc"
msgstr "نحوه استفاده از CC ایمیل"

msgid "Manage the email addresses that should automatically receive a carbon copy of tickets."
msgstr "آدرس‌های ایمیلی را که باید به‌صورت خودکار نسخه CC تیکت‌ها را دریافت کنند مدیریت کنید."

msgid "Add a new recipient to be automatically included in ticket communications."
msgstr "یک گیرنده جدید اضافه کنید تا به‌صورت خودکار در ارتباطات تیکت‌ها قرار گیرد."

msgid "Customize the layout and design of the automated emails sent by your system."
msgstr "چیدمان و طراحی ایمیل‌های خودکاری را که سیستم ارسال می‌کند سفارشی کنید."

msgid "Find documentation and resources to help you master your support platform."
msgstr "مستندات و منابعی را پیدا کنید که به تسلط شما بر پلتفرم پشتیبانی کمک می‌کنند."

msgid "Addons Status"
msgstr "افزودنی‌ها وضعیت"

msgid "Review the current health and activation status of your installed extensions."
msgstr "سلامت فعلی و وضعیت فعال‌سازی افزونه‌های نصب‌شده را بررسی کنید."

